<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F7F8F4" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:paddingStart="16dp" android:paddingEnd="8dp" android:gravity="center_vertical" android:background="#FFFFFF">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/moon_avatar" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="小月助手"
                android:includeFontPadding="false" android:textSize="19sp" android:textStyle="bold" android:textColor="#1B302B"/>
            <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textSize="12sp" android:textColor="#576A62" android:singleLine="true"/>
        </LinearLayout>
        <ImageButton android:id="@+id/connection" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="13dp" android:src="@drawable/ic_link" android:tint="#284E44"
            android:contentDescription="服务器与通知" android:background="?android:attr/selectableItemBackgroundBorderless"/>
        <ImageButton android:id="@+id/permissions" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="13dp" android:src="@drawable/ic_settings" android:tint="#284E44"
            android:contentDescription="权限与后台" android:background="?android:attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E1E6DF"/>
    <TextView android:id="@+id/network_error" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#FFF0D8" android:textColor="#654824" android:padding="10dp" android:textSize="13sp" android:visibility="gone"
        android:accessibilityLiveRegion="polite"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/messages" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" android:dividerHeight="0dp" android:listSelector="@android:color/transparent" android:paddingTop="10dp" android:paddingBottom="10dp"
            android:clipToPadding="false" android:scrollbarStyle="outsideOverlay" android:stackFromBottom="true"/>
        <ScrollView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                android:padding="22dp" android:orientation="vertical">
                <LinearLayout android:id="@+id/empty_card" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="26dp" android:paddingBottom="24dp">
                    <ImageView android:layout_width="54dp" android:layout_height="54dp" android:src="@drawable/moon_avatar" android:importantForAccessibility="no"/>
                    <TextView android:id="@+id/empty_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#203C33" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="14dp" android:gravity="center"/>
                    <TextView android:id="@+id/empty_detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#55665E" android:textSize="14sp" android:layout_marginTop="7dp" android:gravity="center"/>
                    <Button android:id="@+id/empty_action" android:layout_width="wrap_content" android:layout_height="48dp"
                        android:text="连接服务器" android:textSize="15sp" android:layout_marginTop="18dp" android:paddingStart="24dp" android:paddingEnd="24dp"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <LinearLayout android:id="@+id/tool_result" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="14dp" android:paddingEnd="4dp" android:paddingTop="10dp" android:paddingBottom="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本机工具" android:textColor="#456255" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tool_result_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#20382D" android:textSize="14sp" android:maxLines="4" android:ellipsize="end" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
        <Button android:id="@+id/tool_close" android:layout_width="54dp" android:layout_height="48dp" android:text="收起" android:textSize="12sp"
            android:padding="0dp" android:textColor="#33564A" android:background="?android:attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:gravity="center_vertical"
        android:paddingStart="4dp" android:paddingEnd="8dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:background="#FFFFFF">
        <ImageButton android:id="@+id/tools" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_attach"
            android:tint="#3C5A4F" android:padding="12dp" android:contentDescription="打开本机工具" android:background="?android:attr/selectableItemBackgroundBorderless"/>
        <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="46dp"
            android:maxLines="4" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:hint="发消息…" android:textSize="16sp" android:textColor="#23382E" android:textColorHint="#65736A"
            android:inputType="textCapSentences|textMultiLine" android:imeOptions="actionSend"/>
        <ImageButton android:id="@+id/send" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="6dp"
            android:padding="12dp" android:contentDescription="发送消息" android:src="@drawable/ic_send" android:tint="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>
