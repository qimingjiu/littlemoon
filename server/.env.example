# 复制为 .env，由 systemd EnvironmentFile 读取（server.mjs 只读 process.env）
LM_HOST=127.0.0.1
LM_PORT=8792
LM_DATA=./data
# Firebase 服务账号 JSON（与 App 导入的 google-services.json 同一项目）
LM_FCM_SA=./secrets/fcm-sa.json
# 任意 OpenAI 兼容接口
LM_LLM_BASE=https://api.minimaxi.com/v1
LM_LLM_KEY=
LM_LLM_MODEL=MiniMax-M3
LM_PERSONA=./persona.md
LM_USER_NAME=用户
LM_TITLE=小月助手
# 通知里显示正文；设 0 只显示“你有一条新消息”
LM_PREVIEW=1
LM_HISTORY=30
LM_TOOL_WAIT=75000
